# ============================================================================
# app-pip : a scalable pipeline for multi-layer genetic characterisation
#           of the antigen presentation pathway (APP)
#
# Inputs : (1) PHASED, imputed genome-wide genotypes (VCF/VCF.GZ, per chrom
#              or a single file; GRCh37 or GRCh38)
#          (2) HLA allele calls (imputed or typed; VCF/VCF.GZ)
# Output : a per-sample feature matrix spanning the APP, plus a feature
#          dictionary and a QC summary.
#
# NOTE: genome-wide input genotypes must be PHASED (GT separator "|").
#       The pipeline stops with an error if unphased genotypes are found.
# ============================================================================

import os
from snakemake.utils import validate, min_version

min_version("7.0")

configfile: "config/config.yaml"

# Fail early on an invalid configuration (do not continue silently).
validate(config, "../config/config.schema.yaml")

OUTDIR   = config["output_dir"].rstrip("/")
RES      = config["resources"]
BUILD    = str(config["build"])
POSCOL   = "pos38" if BUILD == "38" else "pos37"
HLAFACT  = config["hlafactor"]["binary"]
MODULES  = config["hlafactor"]["modules"]
GENES    = config.get("target_genes", []) or []

WGS_VCF  = config["wgs"]["vcf"]            # pattern containing {chrom} or a single file
CHROMS   = [str(c) for c in config["wgs"]["chroms"]]

# Extended MHC region used to extract HLA calls
HLA_REGION = {"38": ("6", 28510120, 33480577), "37": ("6", 28477797, 33448354)}[BUILD]

# One extraction job per chromosome file (run in parallel); a single
# genome-wide file is extracted as one part named "all".
PER_CHROM = "{chrom}" in WGS_VCF
PARTS = CHROMS if PER_CHROM else ["all"]

def part_input(wc):
    return WGS_VCF.format(chrom=wc.part) if PER_CHROM else WGS_VCF

rule all:
    input:
        f"{OUTDIR}/app_feature_matrix.tsv",
        f"{OUTDIR}/feature_dictionary.tsv",
        f"{OUTDIR}/qc_summary.txt"

# ----------------------------------------------------------------------------
# 1. Target sites from the versioned variant catalogue (exact positions)
# ----------------------------------------------------------------------------
rule make_regions:
    input:
        variants = RES["app_variants"],
        allodefs = RES["allotype_definitions"]
    output:
        tsv = f"{OUTDIR}/regions.tsv"
    params:
        genes  = GENES,
        vep    = config.get("vep_annotation", []) or [],
        poscol = POSCOL
    run:
        import csv
        genes = set(params.genes) if params.genes else None
        vep   = set(params.vep) if params.vep else None
        sites = set()
        with open(input.variants) as fh:
            for row in csv.DictReader(fh, delimiter="\t"):
                if genes and row["gene"] not in genes:
                    continue
                if vep and row["vep_annotation"] not in vep:
                    continue
                if row[params.poscol]:
                    sites.add((row["chrom"], int(row[params.poscol])))
        # allotype-defining sites are always extracted, whatever the VEP filter
        with open(input.allodefs) as fh:
            for row in csv.DictReader(fh, delimiter="\t"):
                if genes and row["gene"] not in genes:
                    continue
                if row[params.poscol]:
                    sites.add((row["chrom"], int(row[params.poscol])))
        os.makedirs(OUTDIR, exist_ok=True)
        key = lambda s: (int(s[0]) if s[0].isdigit() else 99, s[1])
        with open(output.tsv, "w") as out:
            for chrom, pos in sorted(sites, key=key):
                out.write(f"{chrom}\t{pos}\n")

# ----------------------------------------------------------------------------
# 2a. Extract catalogue sites from one input file (one job per chromosome).
#     With a .tbi/.csi index the file is read by random access (-R) and the
#     records are then matched exactly to the catalogue positions (-T);
#     without an index the file is streamed (-T only, slower).
#     Contig names with or without a "chr" prefix are both supported, and a
#     missing ##contig header line is added to the (small) extracted file.
# ----------------------------------------------------------------------------
rule extract_part:
    input:
        vcf = part_input,
        regions = rules.make_regions.output.tsv
    output:
        vcf = temp(f"{OUTDIR}/parts/{{part}}.vcf.gz"),
        tbi = temp(f"{OUTDIR}/parts/{{part}}.vcf.gz.tbi")
    params:
        chrom = lambda wc: wc.part if PER_CHROM else ""
    benchmark:
        f"{OUTDIR}/bench/extract_part_{{part}}.tsv"
    shell:
        r"""
        set -euo pipefail
        tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
        v={input.vcf}
        # catalogue sites for this file
        if [ -n "{params.chrom}" ]; then
            awk -v c="{params.chrom}" '$1 == c' {input.regions} > "$tmp/r.tsv"
        else
            cp {input.regions} "$tmp/r.tsv"
        fi
        # match the contig naming of this file (first record)
        first=$(bcftools query -f '%CHROM\n' "$v" 2>/dev/null | head -n1 || true)
        if [[ "$first" == chr* ]]; then
            awk 'BEGIN{{OFS="\t"}} {{print "chr"$1,$2}}' "$tmp/r.tsv" > "$tmp/r2.tsv"; mv "$tmp/r2.tsv" "$tmp/r.tsv"
        fi
        if [ ! -s "$tmp/r.tsv" ]; then
            # no catalogue site on this chromosome: header-only part
            bcftools view -h "$v" | bgzip > {output.vcf}
        else
            if [ -e "$v.tbi" ] || [ -e "$v.csi" ]; then
                sel=(-R "$tmp/r.tsv" -T "$tmp/r.tsv")
            else
                echo "[app-pip] no index for $v; streaming the whole file (index it with 'bcftools index -t' to speed this up)" >&2
                sel=(-T "$tmp/r.tsv")
            fi
            bcftools view "${{sel[@]}}" "$v" -Oz -o "$tmp/x.vcf.gz"
            if ! bcftools view -h "$tmp/x.vcf.gz" | grep -c '^##contig=' > /dev/null; then
                bcftools view -h "$tmp/x.vcf.gz" \
                  | awk -v r="$tmp/r.tsv" 'BEGIN{{while((getline l < r)>0){{split(l,a,"\t"); if(!(a[1] in s)){{s[a[1]]=1; o[++n]=a[1]}}}}}}
                         /^#CHROM/{{for(k=1;k<=n;k++) print "##contig=<ID="o[k]">"}} {{print}}' > "$tmp/h.txt"
                bcftools reheader -h "$tmp/h.txt" -o "$tmp/y.vcf.gz" "$tmp/x.vcf.gz"
                mv "$tmp/y.vcf.gz" "$tmp/x.vcf.gz"
            fi
            bcftools norm -m -any "$tmp/x.vcf.gz" -Oz -o {output.vcf}
        fi
        bcftools index -t -f {output.vcf}
        """

# ----------------------------------------------------------------------------
# 2b. Merge the parts, then filter on minor allele frequency (computed from
#     the genotypes; no bcftools plugins needed) and imputation R^2.
# ----------------------------------------------------------------------------
rule extract_snps:
    input:
        parts = expand(f"{OUTDIR}/parts/{{part}}.vcf.gz", part=PARTS),
        tbis  = expand(f"{OUTDIR}/parts/{{part}}.vcf.gz.tbi", part=PARTS),
        regions = rules.make_regions.output.tsv
    output:
        vcf = f"{OUTDIR}/app_snps.vcf.gz",
        raw = temp(f"{OUTDIR}/app_snps.raw.vcf.gz"),
        log = f"{OUTDIR}/logs/extract_snps.counts.tsv"
    params:
        maf = config["wgs"]["snp_maf"],
        r2  = config["wgs"]["snp_r2"],
        r2f = config["wgs"]["r2_info_field"]
    benchmark:
        f"{OUTDIR}/bench/extract_snps.tsv"
    shell:
        r"""
        set -euo pipefail
        bcftools concat -a {input.parts} -Oz -o {output.raw}
        bcftools index -t {output.raw}

        if ! bcftools view -h {output.raw} | grep -c '^##INFO=<ID={params.r2f},' > /dev/null; then
            echo "ERROR: INFO/{params.r2f} is not defined in the genotype VCF header." >&2
            echo "Set wgs.r2_info_field in config.yaml to the imputation-quality field used (e.g. R2, DR2, INFO)." >&2
            exit 1
        fi
        # INFO/{params.r2f} absent on a record (e.g. typed variants) -> kept
        bcftools view -e 'INFO/{params.r2f}!="." && INFO/{params.r2f} < {params.r2}' {output.raw} -Ou \
          | bcftools view --min-af {params.maf}:minor -Oz -o {output.vcf}
        bcftools index -t {output.vcf}

        n_target=$(wc -l < {input.regions})
        n_found=$(bcftools view -H {output.raw} | wc -l)
        n_pass=$(bcftools view -H {output.vcf} | wc -l)
        {{
            printf "step\tn\n"
            printf "catalogue_sites\t%s\n" "$n_target"
            printf "extracted_records\t%s\n" "$n_found"
            printf "passed_maf_r2\t%s\n" "$n_pass"
        }} > {output.log}
        """

# ----------------------------------------------------------------------------
# 3. Require phased genotypes. Error out (do not guess) on unphased input.
#    Missing calls ("./.") are allowed and are handled downstream.
# ----------------------------------------------------------------------------
rule check_phased:
    input:
        vcf = rules.extract_snps.output.vcf
    output:
        ok = f"{OUTDIR}/.phased_ok"
    shell:
        r"""
        set -euo pipefail
        n_unphased=$(bcftools query -f '[%GT\n]' {input.vcf} \
                     | grep -cE '^[0-9]+/[0-9]+$' || true)
        if [ "$n_unphased" -gt 0 ]; then
            echo "ERROR: $n_unphased unphased genotype(s) found in {input.vcf}." >&2
            echo "app-pip requires PHASED input (GT separator '|')." >&2
            echo "Please phase the input (e.g. with SHAPEIT or BEAGLE) and rerun." >&2
            exit 1
        fi
        touch {output.ok}
        """

# ----------------------------------------------------------------------------
# 3b. Genotype table for the R steps (CHROM POS ID REF ALT + one GT column per
#     sample). Reading this plain table keeps R free of extra packages.
# ----------------------------------------------------------------------------
rule genotype_table:
    input:
        vcf = rules.extract_snps.output.vcf,
        ok  = rules.check_phased.output.ok
    output:
        tsv = temp(f"{OUTDIR}/app_snps.gt.tsv")
    shell:
        r"""
        set -euo pipefail
        {{
            printf "CHROM\tPOS\tID\tREF\tALT"
            bcftools query -l {input.vcf} | awk '{{printf "\t%s", $0}}'
            printf "\n"
            bcftools query -f '%CHROM\t%POS\t%ID\t%REF\t%ALT[\t%GT]\n' {input.vcf}
        }} > {output.tsv}
        """

# ----------------------------------------------------------------------------
# 4. Variant features: per-variant ALT-allele dosages (additive, 0/1/2)
# ----------------------------------------------------------------------------
rule snp_features:
    input:
        gt  = rules.genotype_table.output.tsv
    output:
        tsv = f"{OUTDIR}/app_snp_features.tsv"
    benchmark:
        f"{OUTDIR}/bench/snp_features.tsv"
    script:
        "scripts/snp_features.R"

# ----------------------------------------------------------------------------
# 5. Allotypes for genes with >= 2 defining missense residues
# ----------------------------------------------------------------------------
rule allotypes:
    input:
        gt   = rules.genotype_table.output.tsv,
        defs = RES["allotype_definitions"]
    output:
        tsv   = f"{OUTDIR}/app_allotypes.tsv",
        sites = f"{OUTDIR}/allotype_sites.tsv"
    params:
        build    = BUILD,
        genes    = config.get("allotype_genes", []) or [],
        target   = GENES,
        min_freq = config["allotype_min_freq"]
    benchmark:
        f"{OUTDIR}/bench/allotypes.tsv"
    script:
        "scripts/allotype.R"

# ----------------------------------------------------------------------------
# 6. HLA region extraction + QC (configurable imputation-quality field).
#    hlafactor uses both 2-field and 4-field allele calls, so all are kept.
# ----------------------------------------------------------------------------
rule extract_hla:
    input:
        vcf = config["hla"]["vcf"]
    output:
        vcf = f"{OUTDIR}/hla_qc.vcf.gz"
    params:
        chrom = HLA_REGION[0], start = HLA_REGION[1], end = HLA_REGION[2],
        maf = config["hla"]["maf"],
        r2  = config["hla"]["r2"],
        r2f = config["hla"]["r2_info_field"]
    benchmark:
        f"{OUTDIR}/bench/extract_hla.tsv"
    shell:
        r"""
        set -euo pipefail
        v={input.vcf}
        [ -s "$v" ] || {{ echo "ERROR: HLA VCF is missing or empty: $v" >&2; exit 1; }}
        first=$(bcftools query -f '%CHROM\n' "$v" | head -n1 || true)
        [ -n "$first" ] || {{ echo "ERROR: no variant records could be read from $v" >&2; exit 1; }}
        c={params.chrom}; [[ "$first" == chr* ]] && c="chr$c"
        if ! bcftools view -h "$v" | grep -c '^##INFO=<ID={params.r2f},' > /dev/null; then
            echo "ERROR: INFO/{params.r2f} is not defined in the header of $v." >&2
            echo "Set hla.r2_info_field in config.yaml (BEAGLE: DR2; Minimac: R2)." >&2
            exit 1
        fi
        # BEAGLE output often lacks ##contig lines, which BCF output requires
        tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
        if ! bcftools view -h "$v" | grep -c "^##contig=<ID=$c[,>]" > /dev/null; then
            bcftools view -h "$v" | awk -v c="$c" '/^#CHROM/{{print "##contig=<ID="c">"}} {{print}}' > "$tmp/h.txt"
            bcftools reheader -h "$tmp/h.txt" -o "$tmp/hla.vcf.gz" "$v"
            v="$tmp/hla.vcf.gz"
        fi
        # -t streams the file, so no .tbi/.csi index is required
        bcftools view -t "$c:{params.start}-{params.end}" "$v" -Ou \
          | bcftools view -e 'INFO/{params.r2f}!="." && INFO/{params.r2f} < {params.r2}' -Ou \
          | bcftools view --min-af {params.maf}:minor -Oz -o {output.vcf}
        bcftools index -t {output.vcf}
        n=$(bcftools view -H {output.vcf} | wc -l)
        [ "$n" -gt 0 ] || {{ echo "ERROR: no HLA alleles left after region/MAF/R2 filtering of $v" >&2; exit 1; }}
        """

# ----------------------------------------------------------------------------
# 7. HLA functional features via hlafactor (one run per requested module)
# ----------------------------------------------------------------------------
rule hlafactor_module:
    input:
        vcf = rules.extract_hla.output.vcf
    output:
        done = f"{OUTDIR}/hlafactor/{{module}}.done"
    params:
        bin = HLAFACT,
        outdir = f"{OUTDIR}/hlafactor"
    benchmark:
        f"{OUTDIR}/bench/hlafactor_{{module}}.tsv"
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.outdir}
        {params.bin} -i {input.vcf} -o {params.outdir}/{wildcards.module}.txt -{wildcards.module}
        touch {output.done}
        """

# ----------------------------------------------------------------------------
# 8. Combine every layer into the final per-sample feature matrix
# ----------------------------------------------------------------------------
rule combine:
    input:
        snps  = rules.snp_features.output.tsv,
        allo  = rules.allotypes.output.tsv,
        sites = rules.allotypes.output.sites,
        counts = rules.extract_snps.output.log,
        hla   = expand(f"{OUTDIR}/hlafactor/{{module}}.done", module=MODULES)
    output:
        matrix = f"{OUTDIR}/app_feature_matrix.tsv",
        dict   = f"{OUTDIR}/feature_dictionary.tsv",
        qc     = f"{OUTDIR}/qc_summary.txt"
    params:
        hladir  = f"{OUTDIR}/hlafactor",
        modules = MODULES,
        build   = BUILD,
        variants = RES["app_variants"]
    benchmark:
        f"{OUTDIR}/bench/combine.tsv"
    script:
        "scripts/combine_matrix.R"
